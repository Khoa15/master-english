# Copy to .env (git-ignored) or set these as real environment variables.
DB_DSN=mysql:host=127.0.0.1;dbname=doradodo;charset=utf8mb4
DB_USER=doradodo
DB_PASS=change-me

# Firebase project id: the "project_id" in app/google-services.json. ID tokens for any other project are rejected.
FIREBASE_PROJECT_ID=your-firebase-project

# Every route lives under <API_BASE_PATH>/v<N>/... ; this is the part before the version (matches api.base.url in the app).
API_BASE_PATH=/api

# Rate limits (fixed windows). IP limit runs before authentication, user limits after it.
RATE_IP_PER_HOUR=30
RATE_USER_PER_HOUR=5
RATE_USER_PER_DAY=20

# Secret that hashes IPs and user ids before they are stored in rate_limits. Use a long random string.
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Comma separated addresses of reverse proxies whose X-Forwarded-For header may be trusted. Empty = trust nobody.
TRUSTED_PROXIES=
