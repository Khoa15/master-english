<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/vocabularyFragment">

    <!-- Main tabs (BottomNavigationView): Vocabulary and Profile -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.doradodo.app.ui.common.TabPlaceholderFragment"
        android:label="@string/nav_tab_profile">
        <action
            android:id="@+id/action_profile_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_subscription"
            app:destination="@id/subscriptionFragment" />
        <action
            android:id="@+id/action_profile_to_feedback"
            app:destination="@id/feedbackFragment" />
        <action
            android:id="@+id/action_profile_to_analytics"
            app:destination="@id/analyticsFragment" />
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/entertainmentFragment"
        android:name="com.doradodo.app.ui.entertainment.EntertainmentFragment"
        android:label="@string/nav_tab_entertainment" />

    <fragment
        android:id="@+id/allGamesFragment"
        android:name="com.doradodo.app.ui.entertainment.AllGamesFragment"
        android:label="allGamesFragment" />

    <fragment
        android:id="@+id/contestFragment"
        android:name="com.doradodo.app.ui.entertainment.ContestFragment"
        android:label="contestFragment" />

    <fragment
        android:id="@+id/contestPlayFragment"
        android:name="com.doradodo.app.ui.entertainment.ContestPlayFragment"
        android:label="contestPlayFragment" />

    <fragment
        android:id="@+id/wordMatchFragment"
        android:name="com.doradodo.app.ui.entertainment.WordMatchFragment"
        android:label="wordMatchFragment" />

    <fragment
        android:id="@+id/synonymMatchFragment"
        android:name="com.doradodo.app.ui.entertainment.SynonymMatchFragment"
        android:label="synonymMatchFragment" />

    <fragment
        android:id="@+id/mistakesFragment"
        android:name="com.doradodo.app.ui.entertainment.MistakesFragment"
        android:label="mistakesFragment" />

    <fragment
        android:id="@+id/guessWordFragment"
        android:name="com.doradodo.app.ui.entertainment.GuessWordFragment"
        android:label="guessWordFragment" />

    <!--
    <fragment
        android:id="@+id/contextFragment"
        android:name="com.doradodo.app.ui.entertainment.ContextFragment"
        android:label="contextFragment" />
    -->

    <fragment
        android:id="@+id/copyFragment"
        android:name="com.doradodo.app.ui.entertainment.CopyFragment"
        android:label="copyFragment" />

    <fragment
        android:id="@+id/tungSetupFragment"
        android:name="com.doradodo.app.ui.entertainment.TungSetupFragment"
        android:label="tungSetupFragment" />

    <fragment
        android:id="@+id/tungFragment"
        android:name="com.doradodo.app.ui.entertainment.TungFragment"
        android:label="tungFragment" />

    <fragment
        android:id="@+id/sleepingFragment"
        android:name="com.doradodo.app.ui.entertainment.SleepingFragment"
        android:label="sleepingFragment" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.doradodo.app.ui.settings.SettingsFragment"
        android:label="@string/settings_title">
        <action
            android:id="@+id/action_settings_to_auth"
            app:destination="@id/authFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Flows outside the tabs -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.doradodo.app.ui.auth.OnboardingFragment"
        android:label="onboarding">
        <action
            android:id="@+id/action_onboarding_to_auth"
            app:destination="@id/authFragment" />
    </fragment>

    <fragment
        android:id="@+id/authFragment"
        android:name="com.doradodo.app.ui.auth.AuthFragment"
        android:label="auth">
        <action
            android:id="@+id/action_auth_to_vocabulary"
            app:destination="@id/vocabularyFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/vocabularyFragment"
        android:name="com.doradodo.app.ui.vocab.VocabularyFragment"
        android:label="vocabulary">
        <action
            android:id="@+id/action_vocab_to_all_packs"
            app:destination="@id/allPacksFragment" />
        <action
            android:id="@+id/action_vocab_to_pack"
            app:destination="@id/packDetailFragment" />
        <action
            android:id="@+id/action_vocab_to_practice"
            app:destination="@id/practiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/allPacksFragment"
        android:name="com.doradodo.app.ui.vocab.AllPacksFragment"
        android:label="all_packs">
        <action
            android:id="@+id/action_allpacks_to_pack"
            app:destination="@id/packDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/packDetailFragment"
        android:name="com.doradodo.app.ui.vocab.PackDetailFragment"
        android:label="pack_detail">
        <argument
            android:name="packId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_pack_to_practice"
            app:destination="@id/practiceFragment" />
    </fragment>

    <fragment
        android:id="@+id/practiceFragment"
        android:name="com.doradodo.app.ui.vocab.PracticeFragment"
        android:label="practice">
        <argument
            android:name="packId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_practice_to_summary"
            app:destination="@id/summaryFragment"
            app:popUpTo="@id/practiceFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.doradodo.app.ui.vocab.SummaryFragment"
        android:label="summary">
        <action
            android:id="@+id/action_summary_to_home"
            app:destination="@id/vocabularyFragment"
            app:popUpTo="@id/vocabularyFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.doradodo.app.ui.analytics.AnalyticsFragment"
        android:label="analytics">
        <action
            android:id="@+id/action_analytics_to_wordlist"
            app:destination="@id/wordListFragment" />
    </fragment>

    <fragment
        android:id="@+id/wordListFragment"
        android:name="com.doradodo.app.ui.vocab.WordListFragment"
        android:label="word_list" />

    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.doradodo.app.ui.feedback.FeedbackFragment"
        android:label="feedback" />

    <fragment
        android:id="@+id/subscriptionFragment"
        android:name="com.doradodo.app.ui.subscription.SubscriptionFragment"
        android:label="subscription" />
</navigation>
