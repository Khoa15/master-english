<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab in the floating nav: a 44dp glossy ink disc centred in the item. Unselected: nothing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item
                android:width="44dp"
                android:height="44dp"
                android:gravity="center">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FF1B1A17"
                        android:endColor="#FF3D3B36" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
