<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Base.Theme.App" />

    <style name="Base.Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/brand_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorSecondaryVariant">@color/brand_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/accent_gold</item>
        <item name="colorError">@color/danger_red</item>
        <item name="android:colorBackground">@color/neutral_bg</item>
        <item name="android:windowBackground">@color/neutral_bg</item>
        <item name="android:colorAccent">@color/brand_green</item>
        <item name="android:colorControlActivated">@color/brand_green</item>
        <item name="colorPrimaryContainer">@color/brand_green_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_green_dark</item>
        <item name="colorSecondaryContainer">@color/brand_green_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_green_dark</item>
        <item name="colorTertiaryContainer">@color/ds_amber_tint</item>
        <item name="colorSurfaceVariant">#F3F1EB</item>
        <item name="colorOnSurfaceVariant">#5B665F</item>
        <item name="colorOutline">#CFC9BC</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:textColorPrimary">@color/neutral_text</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <!-- Inter, the design's typeface, for every text view. -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
    </style>

    <style name="ShapeSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/neutral_border</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/neutral_text</item>
    </style>

    <!-- Onboarding design: outlined option rows, a pill primary button and a serif title -->
    <style name="Widget.Onboarding.Option" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/onboarding_ink</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">@color/onboarding_option_stroke</item>
        <item name="backgroundTint">@color/onboarding_option_fill</item>
    </style>

    <style name="Widget.Onboarding.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">@color/onboarding_green</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Floating nav: the selected tab is a dark ink disc (design: Roadmap artboard, nav). -->
    <style name="Widget.App.NavIndicator" parent="">
        <item name="android:width">40dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.App.GlassNav" parent="ThemeOverlay.Material3.Light">
        <item name="colorSecondaryContainer">@color/brand_green_light</item>
    </style>

    <style name="TextAppearance.Onboarding.Title" parent="android:TextAppearance">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/onboarding_ink</item>
    </style>
</resources>
