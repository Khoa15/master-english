<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Onboarding.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboard_goal_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboard_goal_body"
            android:textColor="@color/onboarding_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/goalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalExam"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_goal_exam" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalCareer"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_goal_career" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalAbroad"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_goal_abroad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalOverseas"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_goal_overseas" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalTravel"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_goal_travel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/goalChat"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboard_goal_chat" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>
</ScrollView>
