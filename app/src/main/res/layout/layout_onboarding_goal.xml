<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/mascot_thinking" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/onboard_question_goal"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_text" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/goalGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:selectionRequired="true"
        app:singleSelection="true"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goalWork"
            style="@style/Widget.MasterEnglish.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/onboard_goal_work" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goalInterview"
            style="@style/Widget.MasterEnglish.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/onboard_goal_interview" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/goalDocs"
            style="@style/Widget.MasterEnglish.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboard_goal_docs" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
