<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboard_question_level"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_text" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/levelGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/levelA1"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/levelA2"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/levelB1"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/levelB2"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="B2" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/profile_target_minutes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/neutral_text" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/minutesGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/min5"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 phút" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/min10"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10 phút" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/min15"
                style="@style/Widget.MasterEnglish.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="15 phút" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>
</ScrollView>
