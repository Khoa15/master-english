<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Onboarding.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboard_age_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboard_age_body"
            android:textColor="@color/onboarding_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/ageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ageUnder18"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_age_under_18" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/age18to24"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_age_18_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/age25to34"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_age_25_34" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/age35to44"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_age_35_44" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/age45to54"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_age_45_54" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/age55plus"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboard_age_55_plus" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>
</ScrollView>
