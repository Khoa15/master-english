<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.Onboarding.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboard_job_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/onboard_job_body"
            android:textColor="@color/onboarding_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/jobGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobSoftware"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_software" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobHealthcare"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_healthcare" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobBusiness"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_business" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobEducation"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_education" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobCreative"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_creative" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobFinance"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
                android:text="@string/onboard_job_finance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jobNotWorking"
                style="@style/Widget.Onboarding.Option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboard_job_not_working" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>
</ScrollView>
